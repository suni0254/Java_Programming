package SeleniumPractice;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collection;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;

import org.openqa.selenium.WebElement;

class Practice_3 {
	public static void main(String[] args) {
		String priceOriginal[] = {"$230","$30","$2","$780"};
		List<String> actualPrice = new ArrayList<String>();
		for(String price:priceOriginal)
		{
			price = price.replaceAll("[^(0-9).]","");
			actualPrice.add(price);
		}
		System.out.println(actualPrice);
		List<Integer> strToInt = new ArrayList<Integer>();
		for(String str:actualPrice)
		{
			strToInt.add(Integer.parseInt(str));
		}
		System.out.println(strToInt);
		Collections.sort(strToInt);
		System.out.println(strToInt);
		Collections.sort(strToInt, Collections.reverseOrder());
		System.out.println(strToInt);
		
	}
}
